
workDir="/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/work"
params {
    //which modules are run
    modules {
        sra2fastq = false
        faqcs = true
        hostRemoval = false
        runAssembly = true
        annotation = true
        readsBinning = true
        phageFinder = true //true by default -- will run if non-viral reads are annotated
        readsTaxonomyAssignment = false
        contigsTaxonomyAssignment = false
        secondaryMetaboliteAnalysis = true
        refBasedAnalysis = true
        snpTree = false
        readsGeneFamilyAnalysis = false
        contigsGeneFamilyAnalysis = false //contig-based requires annotation output as well (GFF,FAA).
    }

    outputLocations {
        //everything in its separate output for the moment
        sra2fastqOutDir =  "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/sra2fastq"
        processProvidedContigsOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234"
        qcOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/ReadsQC"
        hostRemovalOutDir = ""
        assemblyOutDir ="/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Assembly"
        contigsTaxonomyOutDir ="/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Taxonomy"
        phageFinderOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Annotation"
        readBinningOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Binning"
        readsTaxonomyOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Taxonomy"
        annotationOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Annotation"
        smaOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/AntiSmash"
        refBasedOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/RefBased"
        phylogenyOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/Phylogeny"
        geneFamilyOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234/output/GeneFamily"
        reportOutDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/acd1234"
    }

    shared {
        inputFastq = [["/home/user/edge-v3/io/upload/files/8YujqDBVLeq2z5xu.fastq.gz"]]
        inputFastq2 = []
        pairedFile = false
        inputContigs = "${projectDir}/nf_assets/NO_FILE3"
        assembledContigs = "${projectDir}/nf_assets/NO_FILE3" //contigs provided to bypass assembly
        projName = "test_proj"
        fastqSource = null
    }

    sra2fastq {
        accessions = []
    }

    faqcs {
        trimQual = 20
        trim5end = 0
        trim3end = 0
        trimAdapter = false
        trimPolyA = false
        artifactFile = "${projectDir}/nf_assets/NO_FILE3"
        minLen = 50
        avgQual = 0
        numN = 2
        filtLC = 0.85
        filtPhiX = false
        htmlreport = true
    }

    hostRemoval {
        host = ["${projectDir}/nf_assets/NO_FILE3"]
        similarity = 90
        bwaMemOptions = null
    }

    assembly {
        //assemblers: IDBA_UD, SPAdes, Unicycler, Megahit, LRASM
        assembler = "IDBA_UD"
        minContigSize = 200

        idba{
            maxK = null
            minK = 31
            step = 20
        }
        spades {
            pacbio = "${projectDir}/nf_assets/NO_FILE3"
            nanopore = "${projectDir}/nf_assets/NO_FILE4"
            algorithm = null
        }
        megahit {
            preset = null
        }
        unicycler {
            longreads = "${projectDir}/nf_assets/NO_FILE3"
            minLongReads = 2000
            bridgingMode = "normal"
        }
        lrasm {
            preset = null
            algorithm = null
            ec = false
            numConsensus = null
        }
    }

    r2c {
        r2c_aligner = "bwa"
        r2c_aligner_options = ""
        r2g_max_clip = null
        extractUnmapped = false
        rowLimit = null
    }

    annotation {
        contigSizeForAnnotation = 700
        taxKingdom = "bacteria"
        //annotaters: prokka, ratt
        annotateProgram = "prokka" //default
        customProtein = "${projectDir}/nf_assets/NO_FILE" //setup for optional file pattern
        customHMM = "${projectDir}/nf_assets/NO_FILE2"
        sourceGBK = null
        evalue = 0.000000001
        gcode = 11
        keggView = false
        keggViewerDir = "/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests"
    }

    binning {
        binningMinLength = 1000
        binningMaxItr = 50
        binningProb = 0.9
        //107 or 40
        binningMarkerSet = 107
        binningAbundFile = "${projectDir}/nf_assets/NO_FILE3"
        doCheckM = false
        checkMdb = "/media/volume/edgev3-refdata/refdata/checkM_DB"
    }

    readsTaxonomy {
        splitTrimMinQ = 20
        //RTA tools: gottcha-genDB-b,gottcha-speDB-b,gottcha-strDB-b,gottcha-genDB-v,gottcha-speDB-v,gottcha-strDB-v,gottcha2-speDB-b,pangia,bwa,metaphlan4,kraken2,centrifuge,diamond
        enabledTools = "gottcha-genDB-b,gottcha-speDB-b,gottcha-strDB-b,gottcha-genDB-v,gottcha-speDB-v,gottcha-strDB-v,gottcha2-speDB-b,pangia,bwa,metaphlan4,kraken2,centrifuge,diamond"
        baseDB = "/media/volume/edgev3-refdata/refdata"
        custom_gottcha_genDB_b = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_BACTERIA_c4937_k24_u30_xHUMAN3x.genus"
        custom_gottcha_speDB_b = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_BACTERIA_c4937_k24_u30_xHUMAN3x.species"
        custom_gottcha_strDB_b = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_BACTERIA_c4937_k24_u30_xHUMAN3x.strain"
        custom_gottcha_genDB_v = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_VIRUSES_c5900_k24_u30_xHUMAN3x.genus"
        custom_gottcha_speDB_v = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_VIRUSES_c5900_k24_u30_xHUMAN3x.species"
        custom_gottcha_strDB_v = "/media/volume/edgev3-refdata/refdata/nextflow/database/GOTTCHA/GOTTCHA_VIRUSES_c5900_k24_u30_xHUMAN3x.strain"
        custom_gottcha2_speDB_b = "/media/volume/edgev3-refdata/refdata/GOTTCHA2/gottcha_db.species.fna"
        custom_gottcha2_speDB_v = "/media/volume/edgev3-refdata/refdata/GOTTCHA2/gottcha_db.species.fna"
        custom_bwa_db= "/media/volume/edgev3-refdata/refdata/bwa_index/NCBI-Bacteria-Virus.fna"
        custom_metaphlan_db= "/media/volume/edgev3-refdata/refdata/metaphlan4"
        custom_kraken_db= "/media/volume/edgev3-refdata/refdata/Kraken2"
        custom_pangia_db= "/media/volume/edgev3-refdata/refdata/PanGIA/NCBI_genomes_refseq86*.fa"
        custom_diamond_db= "/media/volume/edgev3-refdata/refdata/diamond/RefSeq_Release83.nr_protein_withRefSeq_viral_102317.protein.faa.dmnd"
        custom_centrifuge_db = "/media/volume/edgev3-refdata/refdata/Centrifuge/hpv.1.cf"
    }

    contigsTaxonomy {
        miccrDB = "/media/volume/edgev3-refdata/refdata/miccrDB"
        rowLimit = 3000
    }

    SMA {
        database = "/media/volume/edgev3-refdata/refdata/antismash" //path to downloaded database location (download-antismash-databases --database-dir <DBPATH>)
        smaTaxon = "bacteria"
        clusterblast = false
        subclusterblast = true
        knownclusterblast = true
        mibig = false 
        smcogs = false 
        pfam2go = false
        asf = true 
        rre = true
        fullhmm = false
        tigrfam = false
        cassis = false //only with fungi
    }

    refBased {
        selectGenomes = []
        referenceGenomes = []
        //expects id_mapping.txt in the same directory as refDB
        refDB = "/media/volume/edgev3-refdata/refdata/bwa_index/NCBI-Bacteria-Virus.fna"
        genomeLocation = "/media/volume/edgev3-refdata/refdata/NCBI_genomes"
        r2gAligner = "bwa" //bowtie2, bwa, minimap2
        r2gAlignerOptions = "None"
        r2gMinMapQual = 60
        r2gMaxClip = 50
        r2gVariantCall = true //needs genbank file
        r2gVariantCallMinQual = 60
        r2gVariantCallPloidy = "diploid" 

        //read extraction
        r2gMapUnmapped = false
        r2gExtractMapped = false
        r2gExtractUnmapped = false

        //consensus options
        r2gGetConsensus = false
        r2gConsensusMinMapQual = 60
        r2gConsensusMinCov = 5
        r2gConsensusMaxCov = 8000
        r2gConsensusMinBaseQual = 20
        r2gConsensusAltProp = 0.5
        r2gConsensusAltIndelProp = 0.5
        r2gConsensusDisableBAQ = true
        r2gConsensusPCRdedup = true
        r2gConsensusHomopolymerFilt = false
        r2gConsensusStrandBiasFilt = false
        r2gConsensusVarlogOpt = false
        r2gConsensusCompOpt = false
    } 

    contigsToRef {
        identity = 85
        contigRefDB = "/media/volume/edgev3-refdata/refdata/miccrDB"
        mapUnmappedContigs = false
    }


    snpTree {
        //SNP DB path. Should contain SNPdb, bwa_index, NCBI genomes
        snpDBbase = "/media/volume/edgev3-refdata/refdata"
        //SNP databases: Ecoli, Yersinia, Francisella, Brucella, Bacillus
        snpDBname = null
        //List of genome name from NCBI genomes see $EDGE/edge_ui/data/Ref_list.json
        snpGenomes = []
        //User-provided reference genomes
        snpGenomesFiles = []
        //A reference genome from above two options for reads/contigs mapping
        snpRefGenome = null
        // SRA accessions ByrRun, ByExp, BySample, ByStudy
        phylAccessions = []
        //FastTree or RAxML
        treeMaker = "FastTree"
        phameBootstrap = false
        phameBootstrapNum = 100
    }

    geneFamily{
        inputFAA = "${projectDir}/nf_assets/NO_FILE3" //input for contig-based single-workflow version--needs annotation output
        inputGFF = "${projectDir}/nf_assets/NO_FILE4" //input for contig-based single-workflow version--needs annotation output
        virulenceFactorTool = "MetaVF Toolkit" //"MetaVF Toolkit" or "PathoFact2" 
        rgiDB = "/media/volume/edgev3-refdata/refdata/RGI"
        pf2DB = "/media/volume/edgev3-refdata/refdata/PathoFact2"
        genomadDB = "/media/volume/edgev3-refdata/refdata/genomad_db-v1.6"
        pf2Config = "${projectDir}/modules/geneFamilyAnalysis/resources/usr/bin/EDGE_PF2_Config.yaml"
    }
}

//container settings
apptainer {
    enabled = true
    cacheDir = "/media/volume/edgev3-refdata/refdata/nextflow/.apptainer"
    pullTimeout = "1 hour"
    runOptions = "--compat"
}

//discover and auto-bind subworkflow bin folders
nextflow.enable.moduleBinaries = true

//submission rate limit: needed for sra2fastq to operate correctly
executor {
    submitRateLimit = '1/5sec'
}

//which containers to use for which processes
process {
    withLabel: 'sra2fastq' {
        container = 'ghcr.io/lanl-bioinformatics/edge_sra2fastq:1.6.3'
    }
    withLabel: 'countFastq' {
        container = 'ghcr.io/lanl-bioinformatics/edge_count_fastq:0.3.1'
    }
    withLabel: 'processContigs' {
        container = 'ghcr.io/lanl-bioinformatics/edge_count_fastq:0.3.1'
    }
    withLabel: 'qc'{
        container= 'ghcr.io/lanl-bioinformatics/edge_run_faqcs:1.6.2'
    }
    withLabel: 'hostRemoval' {
        container= 'ghcr.io/lanl-bioinformatics/edge_host_removal:1.7.5'
    }
    withLabel: 'assembly' {
        container = 'ghcr.io/lanl-bioinformatics/edge_run_assembly:1.7.2'
    }
    withLabel: 'r2c' {
        container = 'ghcr.io/lanl-bioinformatics/edge_run_r2c:1.7.0'
    }
    withLabel: 'r2g' {
        container = 'ghcr.io/lanl-bioinformatics/edge_ref_based:0.18.1'
    }
    withLabel: 'rta' {
        container = 'ghcr.io/lanl-bioinformatics/edge_reads_taxonomy:1.15.1'
    }
    withLabel: 'cta' {
        container = 'ghcr.io/lanl-bioinformatics/edge_contigs_taxonomy:1.12.1'
    }

 withLabel: 'annotation' {
        container = 'ghcr.io/lanl-bioinformatics/edge_annotation:0.6.1'
    }
    withLabel: 'phageFinder' {
        container = 'ghcr.io/lanl-bioinformatics/edge_phage_finder:1.2.1'
    }
    withLabel: 'sma' {
        container = 'ghcr.io/lanl-bioinformatics/edge_sma:0.15.3'
    }
    withLabel: 'binning' {
        container = 'ghcr.io/lanl-bioinformatics/edge_binning:1.0.1'
    }
    withLabel: 'phyl' {
        container = 'ghcr.io/lanl-bioinformatics/edge_snp_tree:0.6.2'
    }
    withLabel: 'gfa' {
        container = 'apwat/gene_family_analysis:pf2_0.3.3'
    }
    withLabel: 'vf' {
        container = 'apwat/mvf:0.3'
    }
    withLabel: 'report' {
        container = 'ghcr.io/lanl-bioinformatics/edge_report:0.5.1'
    }
}

report {
    enabled = true
    file = '/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = '/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = '/Users/mflynn/Devel/edge-v3/workflows/Nextflow/scripts/tests/trace.txt'
    fields = 'name,status,start,complete,duration'
    overwrite = true
}

//sets executor to slurm
executor.name = "local"